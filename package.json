{
  "name": "shell-town",
  "version": "1.7.0",
  "private": true,
  "description": "拾贝小镇 (Shell Town) - 家庭积分与宠物养成系统",
  "license": "MIT",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "start": "node server/dist/index.js",
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
